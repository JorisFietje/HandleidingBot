# Google Gemini API-key (verkrijgbaar via https://aistudio.google.com/apikey)
# Vraag de sleutel op bij de projecteigenaar en plak deze hieronder.
GEMINI_API_KEY=jouw_sleutel_hier

# Optioneel: welk Gemini-model gebruikt wordt (standaard gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optioneel: forceer een provider ("ollama" of "gemini").
# Leeg laten = automatisch Gemini zodra er een key staat, anders lokaal Ollama.
# LLM_PROVIDER=

# Optioneel: standaard lokaal Ollama-model (alleen relevant bij provider=ollama)
# OLLAMA_MODEL=qwen2.5:7b
